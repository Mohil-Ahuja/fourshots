# Copy to .env and fill in. Test mode only — never live keys.
# Dashboard -> switch mode selector to Test -> Account & Settings -> API Keys -> Generate Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Webhook signature verification (Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Named in the pre-debit notice and in escalation messages to customers.
MERCHANT_NAME=Example Merchant
# english or hinglish.
OUTREACH_LANGUAGE=english

# Optional: used only by the exception-triage and escalation-copy layers, never
# in the decision path.
ANTHROPIC_API_KEY=

# Serves the demo console at http://localhost:8000/console, which drives this
# service by posting signed synthetic declines at its own webhook endpoint.
# Off by default: it can write entries into the decision log, so a deployment
# that receives real webhooks should not also accept made-up ones.
CONSOLE_ENABLED=false
