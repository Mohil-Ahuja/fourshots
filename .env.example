# Copy to .env and fill in. Test mode only — never live keys.
# Dashboard -> switch mode selector to Test -> Account & Settings -> API Keys -> Generate Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Webhook signature verification (Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Optional: used only by the exception-triage layer, never in the decision path.
ANTHROPIC_API_KEY=
